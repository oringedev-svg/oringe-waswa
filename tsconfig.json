{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Next's actual build always transpiles via SWC regardless of this
    // target, es5 here only controls what tsc's own type-checker accepts
    // as valid syntax. Without this flag, spreading a Set/Map anywhere in
    // the codebase (a completely normal, already-transpiled-fine pattern)
    // fails type-checking with "can only be iterated through when using
    // --downlevelIteration" -- which is exactly the error that broke the
    // Vercel build (workflowCompletion.ts had one such spread that had
    // never been dev-visited, so local `tsc --noEmit` runs never caught
    // it; `next build` checks every route exhaustively).
    "downlevelIteration": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
