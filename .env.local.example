# ============================================================
# Supabase
# Get from: supabase.com → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================================
# AI Provider (any OpenAI-compatible API)
#
# Default: Groq free tier — fast Llama 3.3 70B inference
#   1. Go to https://console.groq.com/keys
#   2. Sign up (free) and create an API key
#   3. Paste it below
#
# To use a different provider, set AI_BASE_URL:
#   Groq (default): https://api.groq.com/openai/v1
#   Together AI:    https://api.together.xyz/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Local Ollama:   http://localhost:11434/v1
#
# If AI_API_KEY is empty, all AI features degrade gracefully
# (submissions still work, they just skip AI analysis).
# ============================================================
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ============================================================
# Email (Gmail App Password)
# 1. Enable 2FA: myaccount.google.com/security
# 2. App Passwords: myaccount.google.com/apppasswords
# 3. Create → Mail → copy 16-char password (no spaces)
# ============================================================
EMAIL_USER=oringedev@gmail.com
EMAIL_APP_PASSWORD=your16charpassword

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Oringe Waswa & Associates

# Generate secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Web Push (PWA notifications)
# Generate a keypair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser; the private key is not.
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@yourfirm.com

# ============================================================
# Google Drive (document storage)
#
# All legal documents live in Google Drive. The app uses a
# service-account to create folders/docs and manage sharing.
#
# Setup (one-time):
#   1. Go to https://console.cloud.google.com
#   2. Create a project (or select an existing one)
#   3. Enable the Google Drive API:
#      APIs & Services → Library → search "Google Drive API" → Enable
#   4. Create a service account:
#      APIs & Services → Credentials → Create Credentials
#      → Service Account → name it (e.g. "oringe-drive")
#      → Grant no project roles → Done
#   5. Create a key for the service account:
#      Click the service account → Keys tab → Add Key
#      → Create new key → JSON → Download
#   6. Open the downloaded JSON file and copy:
#      - "client_email" → paste into GOOGLE_SERVICE_ACCOUNT_EMAIL below
#      - "private_key"  → paste into GOOGLE_SERVICE_ACCOUNT_KEY below
#        (keep the \n line breaks, wrap the whole value in quotes)
#   7. Create a shared folder in Google Drive:
#      - In your firm's Google Drive, create a folder (e.g. "Legal Matters")
#      - Right-click → Share → add the service account email as Editor
#      - Copy the folder ID from the URL:
#        drive.google.com/drive/folders/<THIS_IS_THE_ID>
#      - Paste it into GOOGLE_DRIVE_ROOT_FOLDER_ID below
#
# If these vars are empty, document features fall back to
# Supabase Storage (the existing behaviour).
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_folder_id

# ============================================================
# Google Calendar + Google Meet (per-user OAuth)
#
# NOTE: this is a *different* credential from the Drive service
# account above. A calendar belongs to a person, so writing to
# it (and hosting a Meet link) needs that person's own consent.
# A service account cannot stand in for them.
#
# Works with ordinary free Gmail accounts.
#
# Setup (one-time):
#   1. https://console.cloud.google.com  (same project is fine)
#   2. Enable the Google Calendar API:
#      APIs & Services → Library → "Google Calendar API" → Enable
#   3. Configure the consent screen (ONCE for the whole firm,
#      not once per person):
#      APIs & Services → OAuth consent screen
#      → External → fill in app name + support email
#      → Scopes: add ".../auth/calendar.events"
#      → Test users: add every staff email that will connect
#
#      THEN PUBLISH THE APP ("Publish app" on the same screen).
#      This matters: Google expires refresh tokens after 7 DAYS
#      while publishing status is "Testing", so staff would have
#      to reconnect their calendar every week. Publishing also
#      retires the test-user list, so new staff just connect.
#
#      An unverified published app shows a "Google hasn't
#      verified this app" screen (click Advanced → Go to, once
#      per person) and is capped at 100 users. Both are fine at
#      firm scale. Submit for verification only to remove the
#      warning. On Google Workspace with a custom domain you
#      would instead pick User Type = Internal, which has no
#      warning, no cap and no verification.
#   4. Create the OAuth client:
#      Credentials → Create Credentials → OAuth client ID
#      → Web application
#      → Authorised redirect URI, add BOTH:
#         http://localhost:3000/api/calendar/connect/google/callback
#         https://YOUR-DOMAIN/api/calendar/connect/google/callback
#   5. Copy the Client ID and Client Secret below.
#
# Staff then connect their own calendar from Admin → Calendar.
# If these are empty, the calendar still works: meetings are
# scheduled and .ics invites are still emailed to everyone.
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ============================================================
# Outlook Calendar + Microsoft Teams (per-user OAuth)
#
# IMPORTANT: Outlook Calendar sync works with any Microsoft
# account, but *Teams meeting creation* requires a Microsoft 365
# work or school account with a Teams licence. Personal Microsoft
# accounts cannot host Teams meetings; the app will say so
# clearly and still schedule the meeting.
#
# Setup (one-time):
#   1. https://portal.azure.com → Microsoft Entra ID
#      → App registrations → New registration
#   2. Name it, and under "Supported account types" choose
#      "Accounts in any organizational directory and personal
#      Microsoft accounts" (matches MICROSOFT_OAUTH_TENANT=common)
#   3. Redirect URI → Web → add BOTH:
#         http://localhost:3000/api/calendar/connect/microsoft/callback
#         https://YOUR-DOMAIN/api/calendar/connect/microsoft/callback
#   4. Copy "Application (client) ID" → MICROSOFT_OAUTH_CLIENT_ID
#   5. Certificates & secrets → New client secret
#      → copy the *Value* (not the Secret ID) → CLIENT_SECRET
#   6. API permissions → Add → Microsoft Graph → Delegated:
#         Calendars.ReadWrite, OnlineMeetings.ReadWrite,
#         User.Read, offline_access
#      → Grant admin consent (if you have a tenant)
#
# Set MICROSOFT_OAUTH_TENANT to your tenant id for a
# single-tenant app; leave as "common" otherwise.
# ============================================================
MICROSOFT_OAUTH_CLIENT_ID=your_azure_app_client_id
MICROSOFT_OAUTH_CLIENT_SECRET=your_azure_client_secret_value
MICROSOFT_OAUTH_TENANT=common
