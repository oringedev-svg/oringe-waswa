# ============================================================
# Supabase
# Get from: supabase.com → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================================
# GitHub Models (FREE AI — replaces OpenAI billing)
#
# HOW TO GET YOUR TOKEN:
# 1. Go to https://github.com/settings/tokens
# 2. Click "Generate new token (classic)"
# 3. Name it e.g. "oringe-waswa-ai"
# 4. No special scopes needed — just click Generate
# 5. Copy the token starting with ghp_
#
# SDK USED: @azure-rest/ai-inference
# ENDPOINT: https://models.github.ai/inference
#
# AVAILABLE MODELS (update GITHUB_MODEL to switch):
#   openai/gpt-4.1-mini       <- recommended (fast, smart, free)
#   openai/gpt-4.1            <- most powerful OpenAI
#   openai/gpt-4o             <- GPT-4o
#   openai/gpt-4o-mini        <- lighter GPT-4o
#   openai/o1-mini            <- reasoning
#   openai/o3-mini            <- latest reasoning
#   meta/Meta-Llama-3.3-70B-Instruct  <- open source
#   microsoft/Phi-4           <- Microsoft lightweight
#   deepseek/DeepSeek-R1      <- DeepSeek reasoning
#   mistral-ai/Mistral-large  <- Mistral
#
# Full model list: https://github.com/marketplace/models
# ============================================================
GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=openai/gpt-4.1-mini

# ============================================================
# Email (Gmail App Password)
# 1. Enable 2FA: myaccount.google.com/security
# 2. App Passwords: myaccount.google.com/apppasswords
# 3. Create → Mail → copy 16-char password (no spaces)
# ============================================================
EMAIL_USER=oringedev@gmail.com
EMAIL_APP_PASSWORD=your16charpassword

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Oringe Waswa & Associates

# Generate secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Web Push (PWA notifications)
# Generate a keypair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser; the private key is not.
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@yourfirm.com
