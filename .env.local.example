# ============================================================
# Supabase
# Get from: supabase.com → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================================
# AI Provider (any OpenAI-compatible API)
#
# Default: Groq free tier — fast Llama 3.3 70B inference
#   1. Go to https://console.groq.com/keys
#   2. Sign up (free) and create an API key
#   3. Paste it below
#
# To use a different provider, set AI_BASE_URL:
#   Groq (default): https://api.groq.com/openai/v1
#   Together AI:    https://api.together.xyz/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Local Ollama:   http://localhost:11434/v1
#
# If AI_API_KEY is empty, all AI features degrade gracefully
# (submissions still work, they just skip AI analysis).
# ============================================================
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ============================================================
# Email (Gmail App Password)
# 1. Enable 2FA: myaccount.google.com/security
# 2. App Passwords: myaccount.google.com/apppasswords
# 3. Create → Mail → copy 16-char password (no spaces)
# ============================================================
EMAIL_USER=oringedev@gmail.com
EMAIL_APP_PASSWORD=your16charpassword

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Oringe Waswa & Associates

# Generate secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Web Push (PWA notifications)
# Generate a keypair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser; the private key is not.
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@yourfirm.com
